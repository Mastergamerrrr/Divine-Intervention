[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/text_box.gd" id="1_text"]
[ext_resource type="FontFile" path="res://assets/fonts/PixelOperator8.ttf" id="2_regular"]
[ext_resource type="FontFile" path="res://assets/fonts/PixelOperator8-Bold.ttf" id="3_bold"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_dialogue"]
bg_color = Color(0.094, 0.066, 0.105, 0.98)
border_width_left = 3
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.71, 0.48, 0.31, 1)

[node name="ChildDialogue" type="MarginContainer"]
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -240.0
offset_top = -112.0
offset_right = 240.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
script = ExtResource("1_text")
label_path = NodePath("Padding/MarginContainer/Label")
screen_space = true

[node name="Panel" type="Panel" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_dialogue")

[node name="Padding" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 15
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 15

[node name="MarginContainer" type="VBoxContainer" parent="Padding"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Speaker" type="Label" parent="Padding/MarginContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.67, 0.43, 1)
theme_override_fonts/font = ExtResource("3_bold")
theme_override_font_sizes/font_size = 12
text = "CHILD"

[node name="Label" type="Label" parent="Padding/MarginContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.9, 0.74, 1)
theme_override_fonts/font = ExtResource("2_regular")
theme_override_font_sizes/font_size = 16
autowrap_mode = 3

[node name="LetterDisplayTimer" type="Timer" parent="."]
one_shot = true

[connection signal="timeout" from="LetterDisplayTimer" to="." method="_on_letter_display_timer_timeout"]
